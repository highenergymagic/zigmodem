# Append to /etc/mgetty/mgetty.config. The PTY name matches --device.
port zigmodem
  speed 115200
  data-only yes
  modem-type data
  toggle-dtr no
  ignore-carrier yes
  autobauding no
  open-delay 1000
  data-flow soft
  init-chat "" ATZ OK ATE0Q0V1 OK AT+COMPAT=NATIVE OK AT&K4 OK ATS0=0 OK
  answer-chat "" ATA CONNECT
  answer-chat-timeout 90
  rings 1
  fido-send-emsi no
  debug 4
  login-prompt @ login:
